# Zenodo Sandbox is the safe default.
ZENODO_BASE_URL=https://sandbox.zenodo.org
ZENODO_API_KEY=
ZENODO_ALLOW_PUBLISH=false
ZENODO_MAX_UPLOAD_BYTES=52428800

# Configure only the operator PUBLIC key in the MCP process.
# Keep the matching private key outside the agent/MCP environment.
DEPOSITION_APPROVAL_PUBLIC_KEY_FILE=
DEPOSITION_PUBLICATION_POLICY_VERSION=1
DEPOSITION_APPROVAL_MAX_AGE_SECONDS=900
